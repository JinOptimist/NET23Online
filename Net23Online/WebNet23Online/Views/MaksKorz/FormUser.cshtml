@using WebNet23Online.Data.Models
@using WebNet23Online.Data.Models.MaksKorz
@using WebNet23Online.Models.Maks_Korz
@model List<Location>
<link rel="stylesheet" href="/css/korz/site.css">
<h1>CONCERTS</h1>
<br />
<br />
<br />
@foreach (var location in Model)
{
    <form method="post">
        <table class="element" style="text-align:center" width="100%" border="1" cellpadding="4" cellspacing="0">
            <thead>
                <tr>
                    <th>
                        <div class="element" style="text-align:center">
                            <h1>@location.Country</h1>
                        </div>
                    </th>
                    <th>
                        <div class="element" style="text-align:center">
                            <h1>@location.NameStadium</h1>
                        </div>
                    </th>
                    <th>
                        <div class="element" style="text-align:center">
                            <h1>@location.Capacity</h1>
                        </div>
                    </th>
                    <th>
                        <div>
                            <a href="@Url.Action("GetIDUser", "MaksKorz", new { ID = location.Id})">BOOK</a>
                        </div>
                    </th>
                </thead>
            </table>
        </form>
    }