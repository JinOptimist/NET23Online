@using WebNet23Online.Models.User
@model UserProfileViewModel

<link rel="stylesheet" href="~/css/user/tickets.css" asp-append-version="true" />

<div>
    @Model.UserName (@Model.UserId)
</div>
<div>
    <img src="@Model.AvatarUrl" class="avatar" />
    <form action="/User/UpdateAvatar" method="post" enctype="multipart/form-data">
        <input type="file" name="avatar" />
        <button>Update avatar</button>
    </form>
</div>
<div>
    <form action="/User/ChangeLanguage" method="post">
        @Html.HiddenFor(x => x.UserId)
        @Model.Language.ToString()
        @Html.DropDownList("language", Model.Languages)
        <button>Update language</button>
    </form>
</div>
<div>
    <form action="/User/UpdateProfile" method="post">
        <p>
            First name:<br />
            @Html.TextBoxFor(m => m.FirstName, new { @class = "form-input", type = "text" })
        </p>
        <p>
            Last name:<br />
            @Html.TextBoxFor(m => m.LastName, new { @class = "form-input", type = "text" })
        </p>
        <p>
            Phone number:<br />
            @Html.TextBoxFor(m => m.Mobilephone, new { @class = "form-input", type = "text" })
        </p>
        <button>Save changes</button>
    </form>
</div>
@if (Model.CanShowZooTickets)
{
    <div class="tickets-container">
        <div class="tickets-title">Zoo tickets</div>
        @foreach (var ticket in Model.ZooTickets)
        {
            <div class="ticket-item">
                <div class="ticket-info">
                    <div class="ticket-zoo">@ticket.ZooName</div>
                    <div class="ticket-date">@ticket.EventDate</div>
                </div>
                <div class="ticket-qrcode" data-qr-value="@ticket.UniqueKey"></div>
            </div>
        }
    </div>
}
<script src="~/js/qrcode.js"></script>
<script>
        document.addEventListener("DOMContentLoaded", function () {
        const qrElements = document.querySelectorAll('.ticket-qrcode');
        qrElements.forEach(element => {
            const qrText = element.getAttribute('data-qr-value');
            if (qrText) {
                new QRCode(element, {
                    text: qrText,
                    width: 100,
                    height: 100,
                    colorDark: "#000000",
                    colorLight: "#ffffff",
                    correctLevel: QRCode.CorrectLevel.H
                });
            }
        });
    });
</script>