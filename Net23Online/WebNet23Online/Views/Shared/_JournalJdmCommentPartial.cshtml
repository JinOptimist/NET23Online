@using WebNet23Online.Models.JapaneseDomesticMarket
@using WebNet23Online.Localizations
@using WebNet23Online.Data.Enums
@using WebNet23Online.Services.Interfaces
@inject IAuthService AuthService

@model JournalPostViewModel
<section class="comments" id="comments-@Model.PostId">
<h3>@JapaneseDomesticMarket.Journal_Post_Comment</h3>
   
    
        @foreach (var comments in Model.Comments)
        {
            <article class="comment">
                <strong>@comments.AuthorName</strong>
                <time>@comments.CreatedDate.ToString("dd.MM.yyyy HH:mm")</time>
                <p>@comments.Text</p>
            @if (User.Identity?.IsAuthenticated == true && AuthService.IsAuthenticated() && AuthService.GetRole() == UserRole.JdmOwner)
            {
                <a href="/JapaneseDomesticMarket/DeleteComents?id=@comments.PostsId">Delete</a>
            }
            </article>
        }
    
    @if (User.Identity?.IsAuthenticated == true && AuthService.IsAuthenticated() && AuthService.GetRole() == UserRole.User)
    {
        <form asp-controller="JapaneseDomesticMarket" asp-action="AddComment" method="post">
            <input type="hidden" name="PostId" value="@Model.Form.PostId" />
            <textarea name="Text" rows="3" class="text-comment"></textarea>
            <button type="submit">@JapaneseDomesticMarket.CreateCars_Send_Button</button>
        </form>
    }
    else if (User.Identity?.IsAuthenticated != true)
    {
        <p>@JapaneseDomesticMarket.Journal_Comments_Login</p>
    }
</section>